build*/
/.vs
/CMakeUserPresets.json
dist/
.sdk-cache/

# Vendor runtimes must never enter the history; the release scripts add the pinned
# NVIDIA runtime to the mod archive from .sdk-cache. The staging directory is ignored
# wholesale; the globs catch a DLL dropped anywhere else.
Data/F4SE/Plugins/Fo4VRUpscaler/*
!Data/F4SE/Plugins/Fo4VRUpscaler/OpenXR/
Data/F4SE/Plugins/Fo4VRUpscaler/OpenXR/*
!Data/F4SE/Plugins/Fo4VRUpscaler/OpenXR/Fo4VRUpscalerOpenXR.json
!Data/F4SE/Plugins/Fo4VRUpscaler/.gitkeep
nvngx*.dll
nvngx*.license.txt
sl.*.dll
amd_fidelityfx_*.dll
ffx_*.dll
libxess*.dll
nvsdk_ngx*.h
nvsdk_ngx*.lib

# Reference clones belong outside the tree. Anything matching this is a mistake,
# not a dependency.
*-reference/
